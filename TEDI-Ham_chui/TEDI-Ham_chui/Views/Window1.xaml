<Window x:Class="TEDI_Ham_chui.Views.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TEDI_Ham_chui.Views"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Labels -->
        <TextBlock Text="CR (mm):" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBlock Text="Chamfer (mm):" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBlock Text="W Go (mm):" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBlock Text="Height (mm):" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBlock Text="Width (mm):" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBlock Text="H1 (mm):" Grid.Row="5" VerticalAlignment="Center"/>
        <TextBlock Text="H2 (mm):" Grid.Row="6" VerticalAlignment="Center"/>
        <TextBlock Text="Length (mm):" Grid.Row="7" VerticalAlignment="Center"/>
        <TextBlock Text="H3 (mm):" Grid.Row="8" VerticalAlignment="Center"/>
        <TextBlock Text="radius cut (mm):" Grid.Row="9" VerticalAlignment="Center"/>

        <!-- Input Fields Binded to ViewModel -->
        <TextBox Grid.Column="1" Grid.Row="0" Margin="0,4" Text="{Binding CR, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Column="1" Grid.Row="1" Margin="0,4" Text="{Binding Chamfer, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Column="1" Grid.Row="2" Margin="0,4" Text="{Binding WGo, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Column="1" Grid.Row="3" Margin="0,4" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Column="1" Grid.Row="4" Margin="0,4" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Column="1" Grid.Row="5" Margin="0,4" Text="{Binding H1, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Column="1" Grid.Row="6" Margin="0,4" Text="{Binding H2, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Column="1" Grid.Row="7" Margin="0,4" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Column="1" Grid.Row="8" Margin="0,4" Text="{Binding H3, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Grid.Column="1" Grid.Row="9" Margin="0,4" Text="{Binding RadiusCut, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="OK" Width="80" Height="30" Margin="0,0,10,0" 
                    Command="{Binding OKCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="Cancel" Width="80" Height="30" 
                    Command="{Binding CancelCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
