<Window x:Class="TEDI_Ham_chui_model.Views.RebarAllInOneInput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập thông số thép" Height="650" Width="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="RowInput" TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cover chung -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Lớp bảo vệ bê tông - Cover (mm)" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Column="1" Text="{Binding CoverMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- S1/F1/H1 -->
                <GroupBox Header="Thép S1, F1, H1" Margin="0,0,0,10">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="D (mm)" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Khoảng cách (mm)" Style="{StaticResource ColHeader}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="S1" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiamS1Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SpaceS1Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="F1" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiamF1Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SpaceF1Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="H1" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DiamH1Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding SpaceH1Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>
                    </Grid>
                </GroupBox>

                <!-- S2/F2 -->
                <GroupBox Header="Thép S2, F2 (Rebar_21)" Margin="0,0,0,10">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="D (mm)" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Khoảng cách (mm)" Style="{StaticResource ColHeader}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="S2" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiamS2Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SpaceS2Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="F2" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiamF2Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SpaceF2Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Cạnh dài (mm)" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ShapeUTipMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Cạnh ngắn (mm)" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ShapeCEndCompensationMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                    </Grid>
                </GroupBox>

                <!-- S4/F4/H2 -->
                <GroupBox Header="Thép S4, F4, H2" Margin="0,0,0,10">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="D (mm)" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Khoảng cách (mm)" Style="{StaticResource ColHeader}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="S4" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiamS4Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SpaceS4Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="F4" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiamF4Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SpaceF4Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="H2" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DiamH2Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding SpaceH2Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>
                    </Grid>
                </GroupBox>

                <!-- S6/F6/H3 -->
                <GroupBox Header="Thép S6, F6, H3" Margin="0,0,0,10">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="D (mm)" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Khoảng cách (mm)" Style="{StaticResource ColHeader}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="S6" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiamS6Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SpaceS6Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="F6" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiamF6Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SpaceF6Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="H3" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DiamH3Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding SpaceH3Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>
                    </Grid>
                </GroupBox>

                <!-- S5 -->
                <GroupBox Header="Thép S5" Margin="0,0,0,10">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="D (mm)" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Khoảng cách (mm)" Style="{StaticResource ColHeader}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="S5" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiamS5Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SpaceS5Mm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Vươn (mm)" Style="{StaticResource RowLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VuonMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RowInput}" Margin="0,3,6,3"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Hủy" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="100" Height="35" Margin="0,0,10,0"/>
            <Button Content="Vẽ thép" Command="{Binding OkCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="150" Height="35" Background="DarkSeaGreen" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
