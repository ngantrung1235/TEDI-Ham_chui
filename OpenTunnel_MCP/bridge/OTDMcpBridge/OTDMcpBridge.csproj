<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OTDMcpBridge - add-in .NET chay BEN TRONG OpenTunnel Designer 2026 (26.00.00.83).
    Ma nguon chung nam o Bentley_MCP_Core\bridge (import ben duoi).
    Build: ..\..\scripts\build_bridge.ps1   (tu do runtime .NET va thu muc cai)
       hoac dotnet build -c Release -p:BentleyInstallDir="C:\...\OpenTunnelDesigner\" -p:BentleyTargetFramework=net48
  -->
  <PropertyGroup>
    <AssemblyName>OTDMcpBridge</AssemblyName>
    <Version>0.2.0</Version>
    <BentleyInstallDir Condition="'$(BentleyInstallDir)' == ''">C:\Program Files\Bentley\OpenTunnel Designer 2026\OpenTunnelDesigner\</BentleyInstallDir>
  </PropertyGroup>

  <Import Project="..\..\..\Bentley_MCP_Core\bridge\BentleyMcp.Core.props" />

  <!-- Bang key-in OTDMCP START/STOP/STATUS (ten resource phai trung voi AddInAttribute.KeyinTree) -->
  <ItemGroup>
    <EmbeddedResource Include="commands.xml" LogicalName="OTDMcpBridge.commands.xml" />
  </ItemGroup>

</Project>
